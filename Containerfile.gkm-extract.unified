# Unified GPU runtime - includes both NVIDIA (CUDA/NVML) and AMD (ROCm) support.
# NVIDIA CUDA base provides libnvidia-ml.so.1 for NVIDIA GPU detection via NVML.
# ROCm tools (amd-smi, rocm-smi) are installed for AMD GPU detection.
# A single image supports both GPU vendors; auto-detection occurs at runtime.

# Build stage - follow KServe pattern with golang:1.25
FROM golang:1.25-trixie AS deps

WORKDIR /workspace
COPY mcv/ mcv/
COPY go.mod go.mod
COPY go.sum go.sum
RUN --mount=type=cache,target=/go/pkg/mod \
    go mod download

# ---- Build stage (requires CGO for libgpgme) ----
FROM deps AS builder

# Install build dependencies for CGO
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgpgme-dev \
    libbtrfs-dev \
 && rm -rf /var/lib/apt/lists/*

COPY gkm-extract/ gkm-extract/
COPY pkg/ pkg/
COPY vendor/ vendor/
COPY Makefile Makefile

# Build with CGO enabled (required for containers/image library)
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    make build-gkm-extract

# Runtime stage - NVIDIA CUDA base (Ubuntu 24.04) for NVML + ROCm GPU detection
FROM nvcr.io/nvidia/cuda:12.6.3-base-ubuntu24.04

ARG ROCM_VERSION=7.0.1
ARG AMDGPU_VERSION=7.0.1.70001
ARG OPT_ROCM_VERSION=7.0.1

# Install runtime dependencies (Ubuntu 24.04 / noble package names)
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        ca-certificates \
        libgpgme11t64 \
        libbtrfs0 \
        libffi8 \
        libc6 \
        wget \
        pciutils \
        hwdata \
        gnupg2 \
        python3-setuptools \
        python3-wheel \
        curl \
        lsb-release \
        software-properties-common \
        libseccomp2 && \
    apt-get clean

# Install ROCm for AMD GPU detection (amd-smi, rocm-smi).
# Using Ubuntu 22.04 (jammy) packages as ROCm does not yet officially support Ubuntu 24.04.
RUN wget https://repo.radeon.com/amdgpu-install/${ROCM_VERSION}/ubuntu/jammy/amdgpu-install_${AMDGPU_VERSION}-1_all.deb && \
    apt install -y ./*.deb && \
    apt update && DEBIAN_FRONTEND=noninteractive apt install -y amd-smi-lib rocm-smi-lib && \
    apt-get clean && rm -rf /var/lib/apt/lists/* ./*.deb && \
    ln -s /opt/rocm-${OPT_ROCM_VERSION}/bin/amd-smi /usr/bin/amd-smi && \
    ln -s /opt/rocm-${OPT_ROCM_VERSION}/bin/rocm-smi /usr/bin/rocm-smi

COPY --from=builder /workspace/bin/gkm-extract /gkm-extract

ENTRYPOINT ["/gkm-extract"]
